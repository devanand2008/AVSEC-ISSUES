/* ─── Broadcast ─── */

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum BroadcastAudienceType {
  ALL
  ROLE
  DEPARTMENT
  SECTION
  INDIVIDUAL
}

enum BroadcastDeliveryStatus {
  QUEUED
  DELIVERED
  FAILED
  SKIPPED
}

model Broadcast {
  id              String              @id @default(uuid()) @db.Uuid
  collegeId       String              @map("college_id") @db.Uuid
  authorId        String              @map("author_id") @db.Uuid
  title           String              @db.VarChar(180)
  body            String
  audienceType    BroadcastAudienceType @map("audience_type")
  audienceValue   String?             @map("audience_value") @db.VarChar(120)
  status          BroadcastStatus     @default(DRAFT)
  scheduledAt     DateTime?           @map("scheduled_at") @db.Timestamptz(3)
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz(3)
  failedAt        DateTime?           @map("failed_at") @db.Timestamptz(3)
  cancelledAt     DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  totalRecipients Int                 @default(0) @map("total_recipients")
  deliveredCount  Int                 @default(0) @map("delivered_count")
  failedCount     Int                 @default(0) @map("failed_count")
  errorMessage    String?             @map("error_message") @db.VarChar(500)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  college         College             @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  author          User                @relation("BroadcastAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  recipients      BroadcastRecipient[]

  @@index([collegeId, status, createdAt])
  @@index([collegeId, scheduledAt])
  @@map("broadcasts")
}

model BroadcastRecipient {
  broadcastId     String                  @map("broadcast_id") @db.Uuid
  userId          String                  @map("user_id") @db.Uuid
  status          BroadcastDeliveryStatus @default(QUEUED)
  deliveredAt     DateTime?               @map("delivered_at") @db.Timestamptz(3)
  readAt          DateTime?               @map("read_at") @db.Timestamptz(3)
  failureReason   String?                 @map("failure_reason") @db.VarChar(300)
  broadcast       Broadcast               @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@id([broadcastId, userId])
  @@index([userId, status])
  @@map("broadcast_recipients")
}

