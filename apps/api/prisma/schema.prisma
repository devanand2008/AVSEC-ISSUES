  programmingLanguage String? @map("programming_language") @db.VarChar(40)
  practiceJson Json?   @map("practice_json")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    StudentProgress[]
  bookmarks   LearningBookmark[]

  @@index([moduleId, sortOrder])
  @@map("course_lessons")
}

model CourseResource {
  id          String       @id @default(uuid()) @db.Uuid
  courseId    String       @map("course_id") @db.Uuid
  moduleId    String?      @map("module_id") @db.Uuid
  legacyLearningId String? @unique @map("legacy_learning_id") @db.VarChar(120)
  title       String       @db.VarChar(180)
  description String?      @db.Text
  type        ResourceType @default(OTHER)
  url         String
  uploadedById String?     @map("uploaded_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      CourseModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([courseId, type])
  @@map("course_resources")
}

model CourseAssessment {
  id          String         @id @default(uuid()) @db.Uuid
  courseId    String         @map("course_id") @db.Uuid
  legacyLearningId String?   @unique @map("legacy_learning_id") @db.VarChar(120)
  title       String         @db.VarChar(180)
  description String?        @db.Text
  type        AssessmentType @default(QUIZ)
  maxScore    Int            @default(100) @map("max_score")
  passingScore Int           @default(50) @map("passing_score")
  questionsJson Json?        @map("questions_json")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  results     AssessmentResult[]

  @@index([courseId])
  @@map("course_assessments")
}

model StudentProgress {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  lessonId    String   @map("lesson_id") @db.Uuid
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId, courseId])
  @@map("student_progress")
}

model AssessmentResult {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  assessmentId String  @map("assessment_id") @db.Uuid
  score       Int
  passed      Boolean
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)
  answersJson Json?    @map("answers_json")

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assessment  CourseAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([studentId, assessmentId])
  @@index([courseId])
  @@map("assessment_results")
}

model LearningBookmark {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  lessonId  String   @map("lesson_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId, createdAt])
  @@map("learning_bookmarks")
}

model LearningCertificate {
  id                String   @id @default(uuid()) @db.Uuid
  certificateNumber String   @unique @map("certificate_number") @db.VarChar(60)
  studentId         String   @map("student_id") @db.Uuid
  courseId          String   @map("course_id") @db.Uuid
  assessmentResultId String  @map("assessment_result_id") @db.Uuid
  score             Int
  issuedAt          DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId, issuedAt])
  @@index([courseId])
  @@map("learning_certificates")
}

model LegacyLearningUserMapping {
  id              String   @id @default(uuid()) @db.Uuid
  collegeId       String   @map("college_id") @db.Uuid
  legacyStudentId String?  @map("legacy_student_id") @db.VarChar(120)
  legacyUserId    String?  @map("legacy_user_id") @db.VarChar(120)
  avsUserId       String?  @map("avs_user_id") @db.Uuid
  collegeEmail    String?  @map("college_email") @db.VarChar(254)
  migrationStatus String   @default("PENDING") @map("migration_status") @db.VarChar(40)
  mappedAt        DateTime @default(now()) @map("mapped_at") @db.Timestamptz(3)
  mappedById      String?  @map("mapped_by_id") @db.Uuid
  notes           String?  @db.Text

  @@index([collegeId, migrationStatus])
  @@index([legacyStudentId])
  @@index([legacyUserId])
  @@index([avsUserId])
  @@unique([collegeId, legacyUserId])
  @@map("legacy_learning_user_mappings")
}
