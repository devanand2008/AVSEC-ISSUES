  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
  GRADUATED
  RESIGNED
  ARCHIVED
}

enum ProfileCompletionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  VERIFIED
  REJECTED
}

enum ScopeType {
  COLLEGE
  CAMPUS
  DEPARTMENT
  PROGRAMME
  ACADEMIC_YEAR
  SEMESTER
  SECTION
  BLOCK
  FLOOR
  ROOM
  ISSUE_CATEGORY
  ASSIGNED_ISSUES
