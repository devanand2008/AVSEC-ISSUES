}

model College {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique @db.VarChar(30)
  name        String       @db.VarChar(200)
  timezone    String       @default("Asia/Kolkata") @db.VarChar(80)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  version     Int          @default(1)
  campuses    Campus[]
  departments Department[]
  programmes  Programme[]
  academicYears AcademicYear[]
  users       User[]
  roles       Role[]
  issueCategories IssueCategory[]
  issues      Issue[]
  responsibleTeams ResponsibleTeam[]
  slaPolicies IssueSlaPolicy[]
  announcements Announcement[]
  studentProfiles StudentProfile[]
  staffProfiles StaffProfile[]
  auditLogs AuditLog[]
  backgroundJobFailures BackgroundJobFailure[]
  feedbackTargets FeedbackTarget[]
  feedbackCycles FeedbackCycle[]
  feedbackQuestions FeedbackQuestion[]
  feedbackSubmissions FeedbackSubmission[]
  staffAttendanceRecords StaffAttendanceRecord[]
  attendanceInterventions AttendanceIntervention[]
  attendanceSummaries AttendanceSummary[]
  qrCodes QrCode[]
  qrScanEvents QrScanEvent[]
  broadcasts Broadcast[]
  courses Course[]

  @@map("colleges")
}

model Campus {
  id          String       @id @default(uuid()) @db.Uuid
  collegeId   String       @map("college_id") @db.Uuid
  code        String       @db.VarChar(30)
  name        String       @db.VarChar(160)
  address     String?
  contactNumber String?    @map("contact_number") @db.VarChar(30)
  isActive    Boolean      @default(true) @map("is_active")
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(3)
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  college     College      @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  blocks      Block[]
  departments Department[]
  issues      Issue[]
  feedbackTargets FeedbackTarget[]

  @@unique([collegeId, code])
  @@index([collegeId, isActive, sortOrder])
  @@index([collegeId, archivedAt])
  @@map("campuses")
}

model Department {
  id          String       @id @default(uuid()) @db.Uuid
  collegeId   String       @map("college_id") @db.Uuid
  campusId    String?      @map("campus_id") @db.Uuid
  code        String       @db.VarChar(30)
  name        String       @db.VarChar(180)
  shortName   String?      @map("short_name") @db.VarChar(60)
  description String?
  hodId       String?      @map("hod_id") @db.Uuid
  officialEmail String?    @map("official_email") @db.VarChar(254)
  contactNumber String?    @map("contact_number") @db.VarChar(30)
  location    String?      @db.VarChar(180)
  isActive    Boolean      @default(true) @map("is_active")
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdById String?      @map("created_by_id") @db.Uuid
  updatedById String?      @map("updated_by_id") @db.Uuid
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  college     College      @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  campus      Campus?      @relation(fields: [campusId], references: [id], onDelete: Restrict)
  programmes  Programme[]
  rooms       Room[]
  studentProfiles StudentProfile[]
  staffProfiles StaffProfile[]
  issues      Issue[]
  feedbackTargets FeedbackTarget[]
  feedbackActions FeedbackAction[] @relation("FeedbackActionDepartment")
  courses Course[]

  @@unique([collegeId, code])
  @@unique([collegeId, name])
  @@index([collegeId, isActive])
  @@index([collegeId, archivedAt])
  @@index([hodId])
  @@map("departments")
}

model Programme {
  id          String       @id @default(uuid()) @db.Uuid
  collegeId   String       @map("college_id") @db.Uuid
  departmentId String      @map("department_id") @db.Uuid
  code        String       @db.VarChar(30)
  name        String       @db.VarChar(180)
  degreeType  String?      @map("degree_type") @db.VarChar(80)
  durationYears Int        @map("duration_years")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  college     College      @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  department  Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  semesters   Semester[]
  studentProfiles StudentProfile[]
  courses Course[]

  @@unique([departmentId, code])
  @@map("programmes")
}

model AcademicYear {
  id          String       @id @default(uuid()) @db.Uuid
  collegeId   String       @map("college_id") @db.Uuid
  name        String       @db.VarChar(30)
  startsOn    DateTime     @map("starts_on") @db.Date
  endsOn      DateTime     @map("ends_on") @db.Date
  isCurrent   Boolean      @default(false) @map("is_current")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  college     College      @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  semesters   Semester[]
  attendanceSessions AttendanceSession[]
  attendanceSummaries AttendanceSummary[]
  feedbackCycles FeedbackCycle[]

  @@unique([collegeId, name])
  @@map("academic_years")
}

model Semester {
  id          String       @id @default(uuid()) @db.Uuid
  programmeId String       @map("programme_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  number      Int
  name        String       @db.VarChar(80)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  programme   Programme    @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  sections    Section[]
  subjects    Subject[]
  feedbackCycles FeedbackCycle[]

  @@unique([programmeId, academicYearId, number])
  @@map("semesters")
}

model Section {
  id          String       @id @default(uuid()) @db.Uuid
  semesterId  String       @map("semester_id") @db.Uuid
  code        String       @db.VarChar(30)
  name        String       @db.VarChar(80)
  studyYear   Int?         @map("study_year")
  displayName String?      @map("display_name") @db.VarChar(180)
  assignedRoomId String?   @map("assigned_room_id") @db.Uuid
  officialGroupEnabled Boolean @default(true) @map("official_group_enabled")
  capacity    Int          @default(70)
  isActive    Boolean      @default(true) @map("is_active")
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  semester    Semester     @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  assignedRoom Room?       @relation("SectionAssignedRoom", fields: [assignedRoomId], references: [id], onDelete: Restrict)
  studentProfiles StudentProfile[]
  memberships SectionMembership[]
  coordinatorAssignments ClassCoordinatorAssignment[]
  staffAssignments ClassStaffAssignment[]
  representativeAssignments ClassRepresentativeAssignment[]
  attendanceSessions AttendanceSession[]
  attendanceSummaries AttendanceSummary[]
  facultyAssignments FacultySubjectAssignment[]
  subjectResourceTargets SubjectResourceSection[]
  modelPaperTargets ModelQuestionPaperSection[]

  @@unique([semesterId, code])
  @@index([semesterId, archivedAt])
  @@map("sections")
}

model Subject {
  id          String       @id @default(uuid()) @db.Uuid
  semesterId  String       @map("semester_id") @db.Uuid
  code        String       @db.VarChar(30)
  name        String       @db.VarChar(180)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  semester    Semester     @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  facultyAssignments FacultySubjectAssignment[]
  attendanceSessions AttendanceSession[]
  attendanceSummaries AttendanceSummary[]
  resources     SubjectResource[]
  modelQuestionPapers ModelQuestionPaper[]

  @@unique([semesterId, code])
  @@map("subjects")
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  publicId    String       @unique @default(uuid()) @map("public_id") @db.Uuid
  collegeId   String       @map("college_id") @db.Uuid
  collegeIdentityId String @map("college_identity_id") @db.VarChar(60)
  fullName    String       @map("full_name") @db.VarChar(180)
  email       String?      @db.VarChar(254)
  normalizedEmail String?  @map("normalized_email") @db.VarChar(254)
  mobile      String?      @db.VarChar(30)
  whatsappNumber String?   @map("whatsapp_number") @db.VarChar(30)
  onboardingStudyYear Int? @map("onboarding_study_year")
  importBatchId String?    @map("import_batch_id") @db.Uuid
  status      AccountStatus @default(PENDING)
  mustChangePassword Boolean @default(true) @map("must_change_password")
  firstLoginCompletedAt DateTime? @map("first_login_completed_at") @db.Timestamptz(3)
  profileCompletionStatus ProfileCompletionStatus @default(NOT_STARTED) @map("profile_completion_status")
  profileCompletionPercentage Int @default(0) @map("profile_completion_percentage")
  profileSubmittedAt DateTime? @map("profile_submitted_at") @db.Timestamptz(3)
  profileVerifiedAt DateTime? @map("profile_verified_at") @db.Timestamptz(3)
  profileVerifiedById String? @map("profile_verified_by_id") @db.Uuid
  profileRejectionReason String? @map("profile_rejection_reason") @db.VarChar(500)
  profilePhotoKey String?  @map("profile_photo_key")
  lastLoginAt DateTime?    @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(3)
  version     Int          @default(1)
  college     College      @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  credential  UserCredential?
  sessions    Session[]
  loginAttempts LoginAttempt[]
  passwordResetTokens PasswordResetToken[]
  devices     DeviceRegistration[]
  roles       UserRole[]
  scopes      UserScope[]
  studentProfile StudentProfile?
  staffProfile StaffProfile?
  facultyAssignments FacultySubjectAssignment[]
  coordinatorAssignments ClassCoordinatorAssignment[]
  representativeAssignments ClassRepresentativeAssignment[]
  sectionMemberships SectionMembership[]
  classStaffAssignments ClassStaffAssignment[]
  attendanceSessions AttendanceSession[] @relation("AttendanceFaculty")
  attendanceRecords AttendanceRecord[] @relation("AttendanceStudent")
  attendanceSummaries AttendanceSummary[] @relation("AttendanceSummaryStudent")
  correctionRequests AttendanceCorrectionRequest[] @relation("CorrectionRequester")
  correctionReviews AttendanceCorrectionRequest[] @relation("CorrectionReviewer")
  attendanceChanges AttendanceChangeHistory[] @relation("AttendanceChangeActor")
  staffAttendanceRecords StaffAttendanceRecord[] @relation("StaffAttendanceStaff")
  staffAttendanceRecordsCreated StaffAttendanceRecord[] @relation("StaffAttendanceCreator")
  staffAttendanceRecordsUpdated StaffAttendanceRecord[] @relation("StaffAttendanceUpdater")
  attendanceInterventions AttendanceIntervention[] @relation("AttendanceInterventionStudent")
  attendanceInterventionsCreated AttendanceIntervention[] @relation("AttendanceInterventionCreator")
  qrCodesCreated QrCode[] @relation("QrCodeCreator")
  qrScanEvents QrScanEvent[] @relation("QrScanUser")
  reportedIssues Issue[] @relation("IssueReporter")
  assignedIssues Issue[] @relation("IssueAssignee")
  affectedIssues IssueAffectedUser[]
  issueComments IssueComment[]
  issueAttachments IssueAttachment[]
  issueStatusChanges IssueStatusHistory[]
  responsibleMemberships ResponsibleTeamMember[]
  notifications NotificationRecipient[]
  conversationParticipants ConversationParticipant[]
  messages Message[]
  messageReportsCreated ReportedMessage[] @relation("MessageReporter")
  messageReportsReviewed ReportedMessage[] @relation("MessageReportReviewer")
  messageReads MessageReadReceipt[]
  announcementsCreated Announcement[]
  announcementReads AnnouncementReadReceipt[]
  auditLogs AuditLog[]
  importJobsRequested ImportJob[] @relation("ImportRequester")
  feedbackStaffTargets FeedbackTarget[] @relation("FeedbackStaffTarget")
  feedbackTargetsCreated FeedbackTarget[] @relation("FeedbackTargetCreator")
  feedbackQrCodesCreated FeedbackQrCode[] @relation("FeedbackQrCreator")
  feedbackCyclesCreated FeedbackCycle[] @relation("FeedbackCycleCreator")
  feedbackSubmissions FeedbackSubmission[] @relation("FeedbackStudent")
  feedbackActionsAssigned FeedbackAction[] @relation("FeedbackActionAssignee")
  feedbackActionsCreated FeedbackAction[] @relation("FeedbackActionCreator")
  feedbackScanLogs FeedbackScanLog[] @relation("FeedbackScanStudent")
  broadcastsAuthored Broadcast[] @relation("BroadcastAuthor")
  subjectResourcesUploaded SubjectResource[] @relation("SubjectResourceUploader")
  modelPapersUploaded ModelQuestionPaper[] @relation("ModelPaperUploader")
  subjectResourceViews SubjectResourceView[]

  @@unique([collegeId, collegeIdentityId])
  @@unique([collegeId, normalizedEmail])
  @@index([collegeId, status])
  @@index([collegeId, profileCompletionStatus])
  @@index([collegeId, importBatchId])
  @@map("users")
}

model UserCredential {
  userId      String       @id @map("user_id") @db.Uuid
  passwordHash String      @map("password_hash")
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  failedAttemptCount Int   @default(0) @map("failed_attempt_count")
  lockedUntil DateTime?    @map("locked_until") @db.Timestamptz(3)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model Session {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  familyId    String       @map("family_id") @db.Uuid
  userAgent   String?      @map("user_agent")
  ipAddress   String?      @map("ip_address") @db.VarChar(64)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt  DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?     @map("revoke_reason") @db.VarChar(250)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id          String       @id @default(uuid()) @db.Uuid
  sessionId   String       @map("session_id") @db.Uuid
  tokenHash   String       @unique @map("token_hash")
  issuedAt    DateTime     @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?    @map("used_at") @db.Timestamptz(3)
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(3)
  replacedById String?     @unique @map("replaced_by_id") @db.Uuid
  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
  @@map("refresh_tokens")
}

model LoginAttempt {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String?      @map("user_id") @db.Uuid
  identifierHash String    @map("identifier_hash")
  successful  Boolean
  reason      String?      @db.VarChar(120)
  ipAddress   String?      @map("ip_address") @db.VarChar(64)
  userAgent   String?      @map("user_agent")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifierHash, createdAt])
  @@map("login_attempts")
}

model PasswordResetToken {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  tokenHash   String       @unique @map("token_hash")
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model DeviceRegistration {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  tokenHash   String       @unique @map("token_hash")
  encryptedToken String    @map("encrypted_token")
  platform    String       @db.VarChar(30)
  deviceName  String?      @map("device_name") @db.VarChar(120)
  enabled     Boolean      @default(true)
  lastSeenAt  DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_registrations")
}

model UserPresence {
  userId       String   @id @map("user_id") @db.Uuid
  isOnline     Boolean  @default(false) @map("is_online")
