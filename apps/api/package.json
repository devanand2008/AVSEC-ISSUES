{
  "name": "@college/api",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "npm run prisma:validate && npm run prisma:generate && nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --max-warnings=0 --no-error-on-unmatched-pattern",
    "test": "node --max-old-space-size=4096 ../../node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "bootstrap:production": "tsx prisma/bootstrap-production.ts",
    "env:validate:production": "tsx src/config/validate-production.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1086.0",
    "@aws-sdk/s3-request-presigner": "3.1086.0",
    "@college/shared-types": "2.0.0",
    "@college/validation": "2.0.0",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.4.0",
    "@nestjs/websockets": "11.1.28",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "0.44.0",
    "bullmq": "5.80.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.8.1",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "17.2.3",
    "exceljs": "^4.4.0",
    "firebase-admin": "^14.2.0",
    "helmet": "8.1.0",
    "ioredis": "5.11.1",
    "mammoth": "1.12.0",
    "nestjs-pino": "4.4.1",
    "nodemailer": "^9.0.3",
    "openai": "6.49.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pdf-parse": "2.4.5",
    "pdfkit": "^0.19.1",
    "pg": "8.16.3",
    "pino": "9.13.0",
    "pino-http": "10.5.0",
    "prisma": "7.9.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.3",
    "socket.io": "4.8.3",
    "tsx": "4.20.6",
    "ulid": "3.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "24.7.2",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.3",
    "jest": "30.4.2",
    "supertest": "7.1.4",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
