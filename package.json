{
  "name": "college-administration-platform",
  "version": "2.0.0",
  "private": true,
  "description": "Production college administration, attendance, issue reporting and communication platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "5.0.9",
      "minimatch": "10.2.6"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.2.3"
    },
    "@google-cloud/storage": {
      "fast-xml-parser": "5.10.1",
      "gaxios": "6.7.1",
      "retry-request": "8.0.4",
      "teeny-request": "10.1.4"
    },
    "deepmerge-ts": "8.0.1",
    "archiver-utils": {
      "glob": "13.0.6"
    },
    "brace-expansion": "5.0.9",
    "exceljs": {
      "archiver": "7.0.1",
      "unzipper": "0.12.5",
      "uuid": "11.1.1"
    },
    "fast-uri": "3.1.5",
    "gaxios": {
      "uuid": "11.1.1"
    },
    "google-gax": {
      "rimraf": "6.1.3"
    },
    "lodash": "4.18.1",
    "minimatch": "10.2.6",
    "nanoid": "3.3.18",
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    },
    "postcss": "8.5.24",
    "socket.io-parser": "4.2.7",
    "readdir-glob": {
      "minimatch": "10.2.6"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    },
    "uuid": "11.1.1"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @college/api\" \"npm run dev -w @college/web\"",
    "dev:api": "npm run dev -w @college/api",
    "dev:web": "npm run dev -w @college/web",
    "build": "npm run build -w @college/shared-types && npm run build -w @college/validation && npm run build -w @college/api && npm run build -w @college/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @college/web",
    "test:all": "npm run prisma:validate && npm run typecheck && npm run lint && npm run test && npm run build",
    "check": "npm run prisma:validate && npm run typecheck && npm run lint && npm run test && npm run build",
    "security:dependencies": "node scripts/assert-secure-dependency-tree.mjs",
    "render:validate": "node scripts/validate-render-config.mjs",
    "test:security:dependencies": "node --test scripts/assert-secure-dependency-tree.test.mjs",
    "prisma:generate": "npm run prisma:generate -w @college/api",
    "prisma:validate": "npm run prisma:validate -w @college/api",
    "prisma:migrate": "npm run prisma:migrate -w @college/api",
    "prisma:deploy": "npm run prisma:deploy -w @college/api",
    "env:validate:production": "npm run env:validate:production -w @college/api",
    "seed": "npm run seed -w @college/api",
    "cleanup:data": "tsx scripts/cleanup-unnecessary-data.ts",
    "load:campus": "node scripts/load/campus-concurrency.mjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,json}\" \"*.{md,json,yml}\"",
    "docker:infra": "docker compose up -d postgres redis minio minio-init",
    "docker:down": "docker compose down",
    "security:check": "node scripts/check-sensitive-files.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "backup:verify": "ts-node --project apps/api/tsconfig.json scripts/verify-encrypted-backup.ts"
  },
  "dependencies": {
    "@nestjs/swagger": "11.4.6",
    "exceljs": "^4.4.0",
    "firebase-admin": "^14.2.0",
    "http-proxy": "1.18.1",
    "next": "16.2.12"
  },
  "optionalDependencies": {
    "@napi-rs/canvas-linux-x64-gnu": "0.1.80",
    "@napi-rs/canvas-linux-x64-musl": "0.1.80",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "concurrently": "10.0.4",
    "eslint": "9.39.5",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
