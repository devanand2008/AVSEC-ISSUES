NODE_ENV=development
APP_NAME=AVS College Management System
COLLEGE_NAME=AVS Engineering College
DEFAULT_TIMEZONE=Asia/Kolkata

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000/realtime
CORS_ALLOWED_ORIGINS=http://localhost:3000

PORT=4000
API_PREFIX=api/v1
TRUST_PROXY=false
LOG_LEVEL=info
GLOBAL_RATE_LIMIT_TTL_MS=60000
GLOBAL_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_TTL_MS=60000
LOGIN_RATE_LIMIT_MAX=10

DATABASE_URL=
DATABASE_POOL_MAX=5
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=55432
MONGODB_URI=
REDIS_URL=redis://localhost:56379
REDIS_HOST_PORT=56379

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CSRF_SECRET=
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
PASSWORD_PEPPER=
FEEDBACK_SUBMISSION_SECRET=

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_EXPIRY_SECONDS=300
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Google Drive is an optional private storage/backup provider. OAuth credentials,
# refresh tokens and encryption keys are backend-only and must never use NEXT_PUBLIC_*.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_OWNER_EMAIL=devanand.s2008@gmail.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_FILES_FOLDER_ID=
GOOGLE_DRIVE_ENCRYPTION_KEY=
# Maximum accepted object size. Resumable uploads still use the smaller chunk size below.
GOOGLE_DRIVE_MAX_FILE_SIZE_MB=500
GOOGLE_DRIVE_UPLOAD_CHUNK_SIZE_MB=8

# PostgreSQL backups are always encrypted before leaving temporary local storage.
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_VERSION=1
BACKUP_SCHEDULE_ENABLED=false
BACKUP_SCHEDULE_HOUR=2
BACKUP_DAILY_RETENTION=14
BACKUP_WEEKLY_RETENTION=12
BACKUP_MONTHLY_RETENTION=24

EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_NAME=AVS Engineering College
EMAIL_FROM_ADDRESS=

WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
