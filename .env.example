MAX_POSTER_SIZE_MB=10
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_URL=

# AVS Bot is server-only. Generate a new key and set these only in the backend
# environment; never put the key in Flutter, web, logs, or source control.
AVS_BOT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VECTOR_STORE_ID=
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_REQUEST_TIMEOUT_MS=45000
OPENAI_DAILY_USER_LIMIT=50
OPENAI_MONTHLY_BUDGET_USD=
OPENAI_INPUT_COST_PER_MILLION_USD=
OPENAI_OUTPUT_COST_PER_MILLION_USD=
